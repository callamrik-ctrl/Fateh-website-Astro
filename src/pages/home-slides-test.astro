      .promo-heading h2::before, .promo-heading h2::after { content: ""; width: 22px; height: 2px; border-radius: 2px; background: linear-gradient(90deg, #2563eb, #dc2626); }
      .theme-dark .promo-heading h2 { color: #f8fafc; }
      .promo-arrow { top: calc(50% + 18px); width: 34px; height: 34px; font-size: 24px; }
      .promo-dots { display: flex; justify-content: center; gap: 8px; }
      .promo-dots button { width: 9px; height: 9px; padding: 0; border: 0; border-radius: 50%; background: #cbd5e1; cursor: pointer; }
      .promo-dots button.is-active { width: 22px; border-radius: 6px; background: #dc2626; }
    }
  </style>
  <script is:inline>
    (() => {
      const root = document.querySelector(".promo-slider");
      if (!root) return;
      const track = root.querySelector(".promo-track");
      const real = [...track.querySelectorAll(".promo-slide")];
      const n = real.length;
      const dots = [...root.querySelectorAll(".promo-dots button")];
      // Endless loop: put a copy of all slides before and after the real ones.
      const makeClone = (el) => { const c = el.cloneNode(true); c.setAttribute("aria-hidden", "true"); c.tabIndex = -1;
        const img = c.querySelector("img"); img.removeAttribute("loading"); img.removeAttribute("fetchpriority"); return c; };
      real.slice().reverse().forEach((el) => track.prepend(makeClone(el)));
      real.forEach((el) => track.append(makeClone(el)));
      const all = [...track.querySelectorAll(".promo-slide")]; // [copy | real | copy]
      let pos = n, timer = null, settle = null;
      const leftOf = (i) => all[i].offsetLeft - (track.clientWidth - all[i].clientWidth) / 2;
      const jump = (i) => { track.style.scrollBehavior = "auto"; track.scrollLeft = leftOf(i); track.style.scrollBehavior = ""; };
      const go = (i) => { pos = i; track.scrollTo({ left: leftOf(i), behavior: "smooth" }); };
      const nearest = () => { const mid = track.scrollLeft + track.clientWidth / 2; let best = 0, dist = Infinity;
        all.forEach((s, i) => { const d = Math.abs(s.offsetLeft + s.clientWidth / 2 - mid); if (d < dist) { dist = d; best = i; } }); return best; };
      const mark = () => { const i = nearest(); pos = i; const r = i % n;
        all.forEach((s, k) => s.classList.toggle("is-active", k === i)); dots.forEach((d, k) => d.classList.toggle("is-active", k === r)); };
      // After scrolling stops on a copy, slip back to the same real slide without animation.
      const recentre = () => { const i = nearest(); if (i < n || i >= 2 * n) { jump(n + (i % n)); } mark(); };
      const start = () => { stop(); timer = setInterval(() => go(pos + 1), 5000); };
      const stop = () => { if (timer) clearInterval(timer); timer = null; };
      track.addEventListener("scroll", () => { requestAnimationFrame(mark); clearTimeout(settle); settle = setTimeout(recentre, 160); }, { passive: true });
      root.querySelector(".promo-prev").addEventListener("click", () => { go(pos - 1); start(); });
      root.querySelector(".promo-next").addEventListener("click", () => { go(pos + 1); start(); });
      dots.forEach((d, k) => d.addEventListener("click", () => { go(n + k); start(); }));
      track.addEventListener("touchstart", stop, { passive: true });
      track.addEventListener("touchend", () => setTimeout(start, 4000), { passive: true });
      window.addEventListener("resize", () => jump(pos));
      const init = () => { jump(n); mark(); if (!matchMedia("(prefers-reduced-motion: reduce)").matches) start(); };
      if (document.readyState === "complete") init(); else window.addEventListener("load", init);
    })();
  </script>

