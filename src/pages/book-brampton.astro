---
// Online booking page → /book-brampton.html
// Open times come from Google Calendar through /api/slots.php; bookings are saved
// by /api/book.php (see public/api/). The same link is shared on WhatsApp.
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

// Google Maps key for address autocomplete. Set PUBLIC_GOOGLE_MAPS_KEY in
// Hostinger → Environment variables. Without it, the address is typed by hand.
const MAPS_KEY = import.meta.env.PUBLIC_GOOGLE_MAPS_KEY || "";

const title = "Book a Plumber in Brampton Online | Fateh";
const description = "Book a plumber in Brampton online. Pick a 2-hour arrival window, add your address and photos, and get an email confirmation from Fateh.";
const canonical = "https://fatehplumelec.com/book-brampton.html";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <SiteHeader />

  <main class="bk-wrap">
    <p class="eyebrow">Online booking</p>
    <h1 class="bk-title">Book a plumber in Brampton</h1>
    <p class="bk-lead">Book your Brampton plumber in about a minute. Pick a 2-hour arrival window, tell us about the job, and add a photo if you have one.</p>

    <form id="bk-form" class="bk-card" novalidate>
      <!-- 1. Time -->
      <fieldset class="bk-step">
        <legend><span>1</span> Pick a day and arrival window</legend>
        <div class="bk-days" id="bk-days" role="radiogroup" aria-label="Day"></div>
        <div class="bk-slots" id="bk-slots" role="radiogroup" aria-label="Arrival window"></div>
        <p class="bk-error" data-for="slot"></p>
      </fieldset>

      <!-- 2. Contact -->
      <fieldset class="bk-step">
        <legend><span>2</span> Your details</legend>
        <div class="bk-row">
          <label>First name
            <input name="firstName" autocomplete="given-name" required>
            <span class="bk-error" data-for="firstName"></span>
          </label>
          <label>Last name
            <input name="lastName" autocomplete="family-name" required>
            <span class="bk-error" data-for="lastName"></span>
          </label>
        </div>
        <div class="bk-row">
          <label>Mobile number
            <input name="phone" type="tel" inputmode="tel" autocomplete="tel-national" placeholder="647-555-1234" required>
            <span class="bk-hint">Local GTA numbers only</span>
            <span class="bk-error" data-for="phone"></span>
          </label>
          <label>Email
            <input name="email" type="email" autocomplete="email" placeholder="you@example.com" required>
            <span class="bk-error" data-for="email"></span>
          </label>
        </div>
      </fieldset>

      <!-- 3. Address -->
      <fieldset class="bk-step">
        <legend><span>3</span> Service address</legend>
        <label>Start typing your address
          <div id="bk-place-slot"></div>
          <input name="address" id="bk-address" autocomplete="street-address" placeholder="5 Loomis Rd" required>
          <span class="bk-error" data-for="address"></span>
        </label>
        <label>Unit / Apt (optional)
          <input name="unit" autocomplete="address-line2" placeholder="Basement, Unit 2">
        </label>
        <div class="bk-row">
          <label>City
            <select name="city" id="bk-city" required>
              <option selected>Brampton</option>
              <option>Mississauga</option>
              <option>Caledon</option>
              <option>Vaughan</option>
              <option>Etobicoke</option>
              <option>Toronto</option>
              <option>Other</option>
            </select>
            <span class="bk-hint" id="bk-city-note" hidden>Outside Brampton: we confirm your time by text before the visit.</span>
          </label>
          <label>Postal code
            <input name="postal" id="bk-postal" autocomplete="postal-code" placeholder="L6P 1A1" maxlength="7" required>
            <span class="bk-error" data-for="postal"></span>
          </label>
        </div>
      </fieldset>

      <!-- 4. Job -->
      <fieldset class="bk-step">
        <legend><span>4</span> What do you need?</legend>
        <label>Type of work
          <select name="service" required>
            <option value="">Choose one</option>
            <option>Faucet / tap install or repair</option>
            <option>Clogged drain or toilet</option>
            <option>Toilet repair or install</option>
            <option>Water heater</option>
            <option>Leak</option>
            <option>Sump pump / backwater valve</option>
            <option>Water softener / RO system</option>
            <option>Electrical</option>
            <option>Other</option>
          </select>
          <span class="bk-error" data-for="service"></span>
        </label>
        <label>Describe the job
          <textarea name="details" rows="4" placeholder="Example: kitchen faucet leaking under the sink, new faucet already bought." required></textarea>
          <span class="bk-error" data-for="details"></span>
        </label>
        <label>Photos (optional, up to 3)
          <input name="photos" id="bk-photos" type="file" accept="image/*" multiple>
          <span class="bk-hint">A photo of the problem helps us bring the right parts.</span>
          <span class="bk-error" data-for="photos"></span>
        </label>
        <div class="bk-thumbs" id="bk-thumbs"></div>
      </fieldset>

      <label class="bk-hp" aria-hidden="true">Leave empty <input name="website" tabindex="-1" autocomplete="off"></label>

      <p class="bk-error bk-form-error" id="bk-form-error" role="alert"></p>
      <button class="button bk-submit" type="submit">Request this time</button>
      <p class="bk-small">We confirm every booking by text. Arrival can shift a little within the day; we text you if it does.</p>
      <div class="bk-done" id="bk-done" hidden></div>
    </form>

    <p class="bk-alt">Outside Brampton or an urgent leak? Call <a href="tel:+16479809211"><strong>647-980-9211</strong></a>.</p>
  </main>

  <SiteFooter />

  <script is:inline define:vars={{ MAPS_KEY }}>
  (function () {
    var form = document.getElementById("bk-form");
    var daysEl = document.getElementById("bk-days");
    var slotsEl = document.getElementById("bk-slots");
    var picked = { date: null, slot: null };

    // ---------- Days and slots (live from Google Calendar via /api/slots.php) ----------
    var DAYS = [];
    var submitBtn = form.querySelector(".bk-submit");
    function parseISO(v) { var p = v.split("-"); return new Date(+p[0], +p[1] - 1, +p[2]); }
    function loadSlots() {
      daysEl.innerHTML = '<p class="bk-hint">Loading open times…</p>';
      slotsEl.innerHTML = "";
      picked.date = null; picked.slot = null;
      return fetch("/api/slots.php", { cache: "no-store" })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (!data.ok) throw new Error(data.error || "unavailable");
          DAYS = data.days || [];
          daysEl.innerHTML = "";
          if (!DAYS.length) {
            daysEl.innerHTML = '<p class="bk-hint">No online times open in the next 2 weeks. Please call <a href="tel:+16479809211"><strong>647-980-9211</strong></a>.</p>';
            return;
          }
          DAYS.forEach(function (day, i) {
            var d = parseISO(day.date);
            var b = document.createElement("button");
            b.type = "button"; b.className = "bk-day"; b.setAttribute("role", "radio");
            b.dataset.date = day.date;
            b.innerHTML = "<small>" + d.toLocaleDateString("en-CA", { weekday: "short" }) + "</small><strong>" + d.getDate() + "</strong><small>" + d.toLocaleDateString("en-CA", { month: "short" }) + "</small>";
            b.addEventListener("click", function () { pickDay(b); });
            daysEl.appendChild(b);
            if (i === 0) pickDay(b);
          });
        })
        .catch(function () {
          daysEl.innerHTML = '<p class="bk-error">Online booking is not available right now. Please call <a href="tel:+16479809211"><strong>647-980-9211</strong></a>.</p>';
          submitBtn.disabled = true;
        });
    }
    function pickDay(btn) {
      daysEl.querySelectorAll(".bk-day").forEach(function (x) { x.setAttribute("aria-checked", x === btn); });
      picked.date = btn.dataset.date; picked.slot = null;
      slotsEl.innerHTML = "";
      var day = DAYS.find(function (x) { return x.date === btn.dataset.date; });
      (day ? day.windows : []).forEach(function (w) {
        var s = document.createElement("button");
        s.type = "button"; s.className = "bk-slot"; s.setAttribute("role", "radio");
        s.textContent = w.label; s.dataset.start = w.start;
        if (!w.available) { s.disabled = true; s.title = "Not available"; }
        s.addEventListener("click", function () {
          slotsEl.querySelectorAll(".bk-slot").forEach(function (x) { x.setAttribute("aria-checked", x === s); });
          picked.slot = w.start; picked.label = w.label; setErr("slot", "");
        });
        slotsEl.appendChild(s);
      });
    }

    // Photos are shrunk in the browser before upload (faster on phones, smaller emails)
    function compress(file) {
      return new Promise(function (resolve) {
        if (!/^image\/(jpeg|png|webp)$/.test(file.type)) return resolve(file);
        var url = URL.createObjectURL(file), img = new Image();
        img.onload = function () {
          var k = Math.min(1, 1600 / Math.max(img.naturalWidth, img.naturalHeight));
          var c = document.createElement("canvas");
          c.width = Math.round(img.naturalWidth * k); c.height = Math.round(img.naturalHeight * k);
          c.getContext("2d").drawImage(img, 0, 0, c.width, c.height);
          c.toBlob(function (blob) {
            URL.revokeObjectURL(url);
            resolve(blob && blob.size < file.size ? new File([blob], file.name.replace(/\.\w+$/, "") + ".jpg", { type: "image/jpeg" }) : file);
          }, "image/jpeg", 0.82);
        };
        img.onerror = function () { URL.revokeObjectURL(url); resolve(file); };
        img.src = url;
      });
    }

    // ---------- Validation ----------
    // GTA / Golden Horseshoe area codes
    var AREA_CODES = ["416", "647", "437", "942", "905", "289", "365", "742"];
    function cleanPhone(v) {
      var d = (v || "").replace(/\D/g, "");
      if (d.length === 11 && d[0] === "1") d = d.slice(1);
      return d;
    }
    function checkPhone(v) {
      var d = cleanPhone(v);
      if (d.length !== 10) return "Enter a 10-digit phone number.";
      if (AREA_CODES.indexOf(d.slice(0, 3)) === -1) return "Please use a local GTA number (416, 647, 437, 905, 289, 365...).";
      if (/^(\d)\1{6}$/.test(d.slice(3)) || d.slice(3) === "5551234") return "Please enter a real phone number.";
      return "";
    }
    function checkName(v) {
      v = (v || "").trim();
      if (v.length < 2) return "Required.";
      if (!/^[A-Za-zÀ-ÿ' .-]+$/.test(v)) return "Letters only, please.";
      return "";
    }
    function checkPostal(v) {
      var p = (v || "").toUpperCase().replace(/\s/g, "");
      if (!/^[A-Z]\d[A-Z]\d[A-Z]\d$/.test(p)) return "Enter a valid postal code, like L6P 1A1.";
      if (p[0] !== "L" && p[0] !== "M") return "This postal code is outside our booking area. Please call us.";
      return "";
    }
    function setErr(name, msg) {
      var el = form.querySelector('.bk-error[data-for="' + name + '"]');
      if (el) el.textContent = msg;
      var input = form.elements[name];
      if (input && input.setAttribute) input.setAttribute("aria-invalid", msg ? "true" : "false");
      return !msg;
    }

    // Phone: format as the person types
    var phone = form.elements.phone;
    phone.addEventListener("input", function () {
      var d = cleanPhone(phone.value).slice(0, 10);
      phone.value = d.length > 6 ? d.slice(0, 3) + "-" + d.slice(3, 6) + "-" + d.slice(6) : d.length > 3 ? d.slice(0, 3) + "-" + d.slice(3) : d;
    });
    phone.addEventListener("blur", function () { if (phone.value) setErr("phone", checkPhone(phone.value)); });

    // Postal: uppercase + space
    var postal = form.elements.postal;
    postal.addEventListener("input", function () {
      var p = postal.value.toUpperCase().replace(/[^A-Z0-9]/g, "").slice(0, 6);
      postal.value = p.length > 3 ? p.slice(0, 3) + " " + p.slice(3) : p;
    });
    postal.addEventListener("blur", function () { if (postal.value) setErr("postal", checkPostal(postal.value)); });

    // Photos: max 3, max 8 MB each, show thumbnails
    var photos = document.getElementById("bk-photos"), thumbs = document.getElementById("bk-thumbs");
    photos.addEventListener("change", function () {
      thumbs.innerHTML = "";
      var files = Array.prototype.slice.call(photos.files);
      if (files.length > 3) { setErr("photos", "Up to 3 photos, please."); photos.value = ""; return; }
      if (files.some(function (f) { return f.size > 8 * 1024 * 1024; })) { setErr("photos", "Each photo must be under 8 MB."); photos.value = ""; return; }
      setErr("photos", "");
      files.forEach(function (f) { var img = document.createElement("img"); img.src = URL.createObjectURL(f); img.alt = ""; thumbs.appendChild(img); });
    });

    // ---------- City ----------
    var citySel = document.getElementById("bk-city"), cityNote = document.getElementById("bk-city-note");
    function updateCityNote() { cityNote.hidden = citySel.value === "Brampton"; }
    function setCity(name) {
      if (!name) return;
      // North York, Scarborough etc. come back as their own names: treat as Toronto
      if (/^(north york|scarborough|east york|york)$/i.test(name)) name = "Toronto";
      var hit = Array.prototype.find.call(citySel.options, function (o) { return o.value.toLowerCase() === name.toLowerCase(); });
      citySel.value = hit ? hit.value : "Other";
      updateCityNote();
    }
    citySel.addEventListener("change", updateCityNote);

    // ---------- Address autocomplete (Google Places) ----------
    function fillFromPlace(place) {
      var comps = place.addressComponents || [];
      function get(type) { var c = comps.find(function (x) { return x.types.indexOf(type) !== -1; }); return c ? c.shortText || c.longText : ""; }
      var line = [get("street_number"), get("route")].filter(Boolean).join(" ");
      var city = get("locality") || get("sublocality") || get("administrative_area_level_3");
      document.getElementById("bk-address").value = line || place.formattedAddress || "";
      setCity(city);
      var pc = get("postal_code");
      if (pc) { postal.value = pc.toUpperCase(); setErr("postal", checkPostal(pc)); }
      setErr("address", "");
    }
    if (MAPS_KEY) {
      var s = document.createElement("script");
      s.src = "https://maps.googleapis.com/maps/api/js?key=" + encodeURIComponent(MAPS_KEY) + "&v=weekly&loading=async&callback=bkMapsReady";
      s.async = true;
      window.bkMapsReady = async function () {
        try {
          var lib = await google.maps.importLibrary("places");
          // Only addresses in Canada, inside a box around the GTA (Hamilton to Pickering, Lake Ontario to Caledon)
          var el = new lib.PlaceAutocompleteElement({
            includedRegionCodes: ["ca"],
            locationRestriction: { north: 44.15, south: 43.20, east: -78.95, west: -80.10 }
          });
          el.setAttribute("placeholder", "Start typing, e.g. 5 Loomis Rd");
          el.className = "bk-place";
          document.getElementById("bk-place-slot").appendChild(el);
          var plain = document.getElementById("bk-address");
          plain.type = "hidden";
          el.addEventListener("gmp-select", async function (e) {
            var place = e.placePrediction.toPlace();
            await place.fetchFields({ fields: ["addressComponents", "formattedAddress"] });
            fillFromPlace(place);
          });
        } catch (err) { /* keep the plain address box */ }
      };
      document.head.appendChild(s);
    }

    // ---------- Submit ----------
    form.addEventListener("submit", function (e) {
      e.preventDefault();
      if (form.elements.website.value) return; // bot
      var ok = true;
      ok = setErr("slot", picked.slot ? "" : "Pick an arrival window.") && ok;
      ok = setErr("firstName", checkName(form.elements.firstName.value)) && ok;
      ok = setErr("lastName", checkName(form.elements.lastName.value)) && ok;
      ok = setErr("phone", checkPhone(phone.value)) && ok;
      ok = setErr("email", /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(form.elements.email.value.trim()) ? "" : "Enter a valid email.") && ok;
      ok = setErr("address", form.elements.address.value.trim().length >= 5 ? "" : "Enter your street address.") && ok;
      ok = setErr("postal", checkPostal(postal.value)) && ok;
      ok = setErr("service", form.elements.service.value ? "" : "Choose the type of work.") && ok;
      ok = setErr("details", form.elements.details.value.trim().length >= 10 ? "" : "Tell us a little more (10+ characters).") && ok;
      if (!ok) { var first = form.querySelector('[aria-invalid="true"], .bk-error:not(:empty)'); if (first) first.scrollIntoView({ behavior: "smooth", block: "center" }); return; }

      var formErr = document.getElementById("bk-form-error");
      formErr.textContent = "";
      submitBtn.disabled = true;
      submitBtn.textContent = "Sending…";
      var fd = new FormData(form);
      fd.delete("photos");
      fd.append("date", picked.date);
      fd.append("start", picked.slot);
      Promise.all(Array.prototype.map.call(photos.files, compress))
        .then(function (files) {
          files.forEach(function (f) { fd.append("photos[]", f, f.name); });
          return fetch("/api/book.php", { method: "POST", body: fd });
        })
        .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
        .then(function (res) {
          if (res.ok) {
            var done = document.getElementById("bk-done");
            form.querySelectorAll(".bk-step, .bk-submit, .bk-small").forEach(function (el) { el.hidden = true; });
            done.hidden = false;
            done.innerHTML = "<strong>Booking received ✓</strong><p>" + (res.when || "") + "<br>" + (res.address || "") +
              "</p><p>We sent a confirmation to your email and will text you to confirm. Questions? Call 647-980-9211.</p>";
            done.scrollIntoView({ behavior: "smooth", block: "center" });
            return;
          }
          var fields = res.fields || {};
          Object.keys(fields).forEach(function (k) { setErr(k, fields[k]); });
          if (res.refresh) loadSlots();
          var box = form.querySelector(".bk-error:not(:empty)");
          formErr.textContent = res.error || "Something went wrong. Please call 647-980-9211.";
          (box || formErr).scrollIntoView({ behavior: "smooth", block: "center" });
        })
        .catch(function () { formErr.textContent = "Could not send your booking. Please check your connection or call 647-980-9211."; })
        .finally(function () { submitBtn.disabled = false; submitBtn.textContent = "Request this time"; });
    });

    loadSlots();
  })();
  </script>
</BaseLayout>

<style is:global>
  .bk-card [hidden] { display: none !important; }
  .bk-wrap { max-width: 760px; margin: 0 auto; padding: 48px 20px 64px; }
  .bk-title { margin: 0 0 8px; font-size: clamp(2rem, 4.5vw, 3rem); line-height: 1.1; }
  .bk-lead { margin: 0 0 28px; color: var(--muted); font-size: 1.08rem; }
  .bk-card { padding: 8px 24px 24px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--white); box-shadow: var(--shadow); }
  .bk-step { border: 0; border-bottom: 1px solid var(--line); margin: 0; padding: 22px 0; min-width: 0; }
  .bk-step legend { display: flex; align-items: center; gap: 10px; padding: 0; margin-bottom: 14px; font-weight: 800; font-size: 1.1rem; color: var(--ink); }
  .bk-step legend span { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--brand); color: #fff; font-size: .9rem; }
  .bk-card label { display: grid; gap: 6px; margin-bottom: 14px; font-weight: 700; font-size: .95rem; color: var(--ink); }
  .bk-card input:not([type="file"]), .bk-card select, .bk-card textarea { width: 100%; padding: 12px 14px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--white); color: var(--ink); font: inherit; font-weight: 400; }
  .bk-card input:not([type="file"]), .bk-card select { height: 50px; margin: 0; }
  .bk-card input:focus, .bk-card select:focus, .bk-card textarea:focus { outline: 2px solid var(--brand); outline-offset: 1px; border-color: var(--brand); }
  .bk-card [aria-invalid="true"] { border-color: var(--accent); }
  .bk-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0 16px; }
  .bk-hint { color: var(--muted); font-weight: 400; font-size: .85rem; }
  .bk-error { color: var(--accent); font-weight: 600; font-size: .88rem; margin: 0; }
  .bk-error:empty { display: none; }
  .bk-days { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 6px; margin-bottom: 14px; }
  .bk-day { flex: 0 0 auto; display: grid; justify-items: center; min-width: 62px; padding: 8px 6px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--white); color: var(--ink); cursor: pointer; font: inherit; }
  .bk-day strong { font-size: 1.25rem; line-height: 1.2; }
  .bk-day small { color: var(--muted); font-size: .75rem; }
  .bk-slots { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
  .bk-slot { padding: 12px 8px; border: 1px solid var(--brand); border-radius: var(--radius); background: var(--white); color: var(--brand); font: inherit; font-weight: 700; cursor: pointer; }
  .bk-slot:disabled { border-color: var(--line); color: var(--muted); text-decoration: line-through; cursor: not-allowed; opacity: .6; }
  .bk-form-error { margin-top: 16px; text-align: center; }
  .bk-submit:disabled { opacity: .7; cursor: wait; }
  .bk-day[aria-checked="true"], .bk-slot[aria-checked="true"] { background: var(--brand); border-color: var(--brand); color: #fff; }
  .bk-day[aria-checked="true"] small { color: #fff; }
  /* Google address box: light by default, dark only when the site's dark theme is on */
  .bk-place { display: block; width: 100%; color-scheme: light; background-color: #fff; border: 1px solid var(--line); border-radius: var(--radius); }
  .bk-place:focus-within { border-color: var(--brand); outline: 2px solid var(--brand); outline-offset: 1px; }
  body.theme-dark .bk-place { color-scheme: dark; background-color: var(--white); }
  .bk-thumbs { display: flex; gap: 8px; }
  .bk-thumbs img { width: 72px; height: 72px; object-fit: cover; border-radius: var(--radius); border: 1px solid var(--line); }
  .bk-hp { position: absolute; left: -9999px; }
  .bk-submit { width: 100%; margin-top: 22px; padding: 14px; font-size: 1.05rem; cursor: pointer; }
  .bk-small { margin: 10px 0 0; color: var(--muted); font-size: .88rem; text-align: center; }
  .bk-done { margin-top: 18px; padding: 16px; border-radius: var(--radius); background: #ecfdf3; color: #065f46; border: 1px solid #a7f3d0; }
  .bk-done p { margin: 6px 0 0; }
  .bk-alt { margin-top: 18px; text-align: center; color: var(--muted); }
  .bk-alt a { color: #2563eb; font-weight: 700; }
  @media (max-width: 640px) {
    .bk-card { padding: 4px 16px 18px; }
    .bk-row { grid-template-columns: 1fr; }
    .bk-slots { grid-template-columns: 1fr 1fr; }
  }
</style>
