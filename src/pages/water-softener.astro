const related = [
  { title: "RO System Installation", href: "reverse-osmosis-system.html", text: "Under-sink reverse osmosis for clean drinking water." },
  { title: "Water Heater Repair", href: "water-heater-repair.html", text: "No hot water, leaking tanks and scale-damaged heaters." },
  { title: "Tankless Water Heater", href: "tankless-water-heater.html", text: "Tankless installs and descaling, where soft water helps most." },
