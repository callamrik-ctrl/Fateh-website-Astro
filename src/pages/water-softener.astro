const sizing = [
  { people: "1–2 people", capacity: "About 24,000–32,000 grain", note: "Condos, townhomes, smaller households" },
  { people: "3–4 people", capacity: "About 32,000–40,000 grain", note: "Most detached homes in Brampton" },
  { people: "5–6 people", capacity: "About 40,000–48,000 grain", note: "Larger families, basement suites" },
  { people: "Well water / iron", capacity: "Sized after testing", note: "Higher hardness and iron need a bigger or twin system" },
];

const compareRows = [
  { label: "Removes hardness (scale)", softener: "Yes", salt: "No — reduces scale sticking", ro: "Yes, at one tap only" },
  { label: "Treats the whole house", softener: "Yes", salt: "Yes", ro: "No — kitchen tap" },
  { label: "Better drinking water taste", softener: "Not the main job", salt: "No", ro: "Yes" },
  { label: "Uses salt", softener: "Yes", salt: "No", ro: "No" },
