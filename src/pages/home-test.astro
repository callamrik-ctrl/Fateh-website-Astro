  <script is:inline>
    (function () {
      var track = document.getElementById("ht-track"), dotsBox = document.getElementById("ht-dots");
      if (!track) return;
      var slides = track.children, n = slides.length, i = 0, timer;
      for (var k = 0; k < n; k++) (function (k) {
        var b = document.createElement("button"); b.type = "button"; b.setAttribute("aria-label", "Show offer " + (k + 1));
        b.onclick = function () { go(k); restart(); }; dotsBox.appendChild(b);
      })(k);
      function paint() { for (var k = 0; k < n; k++) dotsBox.children[k].setAttribute("aria-current", k === i ? "true" : "false"); }
      function go(k) { i = (k + n) % n; track.scrollTo({ left: track.clientWidth * i, behavior: "smooth" }); paint(); }
      function restart() { clearInterval(timer); timer = setInterval(function () { go(i + 1); }, 5000); }
      document.querySelector(".ht-prev").onclick = function () { go(i - 1); restart(); };
      document.querySelector(".ht-next").onclick = function () { go(i + 1); restart(); };
      track.addEventListener("scroll", function () { var k = Math.round(track.scrollLeft / track.clientWidth); if (k !== i) { i = k; paint(); } }, { passive: true });
      track.addEventListener("mouseenter", function () { clearInterval(timer); });
      track.addEventListener("mouseleave", restart);
      paint(); restart();
    })();
  </script>


