---
const {
  title,
  description,
  canonical,
  ogImage = "https://fatehplumelec.com/assets/fateh-logo-clean.png",
  baseHref,
  schemas = [],
  ogType = "website",
  noindex = false,
} = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  {baseHref && <base href={baseHref} />}
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  {schemas.map((schema) => <script type="application/ld+json" set:html={schema} />)}
  <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
  <!-- Christmas: Santa replaces the header van until midnight Dec 31, 2026 (Toronto = UTC-5) -->
  <script is:inline>if (Date.now() < Date.UTC(2027, 0, 1, 5, 0, 0)) { var h = document.documentElement; h.classList.add("season-santa"); var s = new Image(); s.onload = function () { h.classList.add("santa-ready"); }; s.src = "/assets/seasonal/santa-sleigh-reindeer.webp"; }</script>
  <link rel="stylesheet" href="/styles.css?v=20261128-santa4" />
</head>
<body>
  <slot />
  <script is:inline src="/form-config.js?v=20260602-leads"></script>
  <script is:inline src="/script.js?v=20261127-careers"></script>
</body>
</html>
