---
const { inline = false } = Astro.props;
// Small trust row: Red Seal tickets, languages, licensed/insured. Used on home, about, contact and Brampton pages.
---
<section class:list={["credentials-strip", { "credentials-inline": inline }]} aria-label="Qualifications and languages">
  <div class="credential">
    <span class="credential-icon" aria-hidden="true">★</span>
    <span><strong>Red Seal certified</strong><small>Plumber &amp; Electrician</small></span>
  </div>
  <div class="credential">
    <span class="credential-icon" aria-hidden="true">💬</span>
    <span><strong>We speak your language</strong><small>English, Punjabi &amp; Hindi</small></span>
  </div>
  <div class="credential">
    <span class="credential-icon" aria-hidden="true">✓</span>
    <span><strong>Licensed &amp; insured</strong><small>10+ years in Brampton &amp; the GTA</small></span>
  </div>
</section>
