---
// Christmas option B: every so often Santa sweeps up from the left of the screen and flies out to the right.
// Pass demo={true} to let a button replay it right away.
const { everySeconds = 45, firstAfter = 4, until = "2027-01-01T05:00:00Z" } = Astro.props;
---
<div class="santa-flyover" aria-hidden="true"><img src="/assets/seasonal/santa-sleigh.svg" alt="" width="600" height="210"></div>
<style is:inline>
  .santa-flyover { position: fixed; left: 0; bottom: 18vh; z-index: 90; width: clamp(170px, 24vw, 340px); pointer-events: none; opacity: 0; }
  .santa-flyover img { display: block; width: 100%; height: auto; filter: drop-shadow(0 10px 12px rgba(15, 23, 42, .25)); }
  .santa-flyover.is-flying { animation: santaSweep 7s cubic-bezier(.45, .05, .4, 1) forwards; }
  @keyframes santaSweep {
    0%   { opacity: 0; transform: translate(-40vw, 10vh) rotate(-4deg) scale(.8); }
    8%   { opacity: 1; }
    35%  { transform: translate(10vw, -18vh) rotate(-16deg) scale(.95); }
    60%  { transform: translate(42vw, -42vh) rotate(-6deg) scale(1); }
    80%  { transform: translate(72vw, -52vh) rotate(4deg) scale(.92); opacity: 1; }
    100% { opacity: 0; transform: translate(112vw, -58vh) rotate(8deg) scale(.82); }
  }
  @media (prefers-reduced-motion: reduce) { .santa-flyover { display: none; } }
</style>
<script is:inline define:vars={{ everySeconds, firstAfter, until }}>
  (function () {
    if (Date.now() >= Date.parse(until)) return;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var el = document.querySelector(".santa-flyover");
    if (!el) return;
    function fly() { el.classList.remove("is-flying"); void el.offsetWidth; el.classList.add("is-flying"); }
    window.santaFly = fly;
    setTimeout(function () { fly(); setInterval(function () { if (!document.hidden) fly(); }, everySeconds * 1000); }, firstAfter * 1000);
  })();
</script>
